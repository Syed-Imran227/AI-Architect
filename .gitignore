# Test runner cache
.pytest_cache/

# Secrets: backend/.env holds live GROQ_API_KEY / JWT_SECRET / MONGO_URI.
# `.env` above only matches that exact name, so a `.env.production` or
# `.env.backup` would still be committable. Ignore every variant.
.env.*
!.env.example


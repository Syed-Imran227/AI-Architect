# ==============================================================================
# AI Architect — Backend Environment Configuration
# ==============================================================================
# Copy this file to .env in the backend/ directory:
#   cp .env.example .env
# ==============================================================================

# ── 1. Runtime Environment & CORS ─────────────────────────────────────────────
# Options: 'development' or 'production' (in production, strict 32+ char JWT check is enforced)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ── 2. Storage & Authentication Providers ─────────────────────────────────────
# DATABASE_PROVIDER: 'mongodb' (default) or 'supabase' (PostgreSQL with RLS)
DATABASE_PROVIDER=mongodb

# AUTH_PROVIDER: 'jwt' (default custom HS256 auth) or 'supabase' (Supabase Auth)
AUTH_PROVIDER=jwt

# ── 3. MongoDB Configuration (Required when DATABASE_PROVIDER=mongodb) ────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_architect?retryWrites=true&w=majority

# ── 4. Custom JWT Authentication (Required when AUTH_PROVIDER=jwt) ────────────
# Must be a secure random string (minimum 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# ── 5. Supabase Configuration (Required when provider is 'supabase') ───────────
SUPABASE_URL=https://your-project-id.supabase.co
# Publishable / Anon Key (for client operations):
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=sb_publishable_your_key_here
# Service Role Key (secret, backend admin access — bypasses RLS for system operations):
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT Secret (found in Supabase Settings -> API -> JWT Settings):
SUPABASE_JWT_SECRET=
# Direct PostgreSQL connection string (for migrations / direct pooling):
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ── 6. AI & Multi-Provider LLM Fallback Chain ────────────────────────────────
# At least ONE API key is required to run the generative spatial reasoning pipeline.
# The system falls back in this order:
#   1. Gemini 3.1 Pro Preview (Google AI Studio)
#   2. DeepSeek-V3-0324 (Hugging Face Router)
#   3. Gemini 3.8 Flash (Google AI Studio)
#   4. Qwen 3.8-27B (Groq)
#   5. Gemini 3.5 Flash-Lite (Google AI Studio)

# Google AI Studio API Key (powers Gemini 3.1 Pro, 3.8 Flash, and 3.5 Flash-Lite):
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (powers fast open-weight Qwen 3.8-27B fallback):
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Key (powers DeepSeek-V3-0324 router fallback):
HF_API_KEY=your_huggingface_api_key_here

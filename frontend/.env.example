# Frontend Environment Configuration

# Authentication Provider: 'jwt' (default legacy custom JWT flow) or 'supabase' (Supabase Auth)
VITE_AUTH_PROVIDER=jwt

# Supabase Project Configuration (Required when VITE_AUTH_PROVIDER=supabase)
# NOTE: Only use publishable / anon keys here. NEVER expose service_role keys or secrets to the frontend!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# ==============================================================================
# AI Architect — Frontend Environment Configuration
# ==============================================================================
# NOTE: In Vite, all client-exposed environment variables MUST start with VITE_.
# Variables without this prefix (such as NEXT_PUBLIC_*) are NOT exposed to the client!
# ==============================================================================

# ── 1. Backend API Base URL ───────────────────────────────────────────────────
# URL where your FastAPI backend is running (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# ── 2. Authentication Provider ────────────────────────────────────────────────
# Options: 'jwt' (default legacy custom JWT flow) or 'supabase' (Supabase Auth)
VITE_AUTH_PROVIDER=jwt

# ── 3. Supabase Configuration (Required when VITE_AUTH_PROVIDER=supabase) ─────
# NOTE: Only use your public / anon key here. NEVER expose your service_role key to frontend!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
